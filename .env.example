# Create a free Neon PostgreSQL database and paste its connection string (with sslmode=require).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Required only to create the very first administrator (minimum 12 characters).
# Once the account exists, change/remove ADMIN_PASSWORD in Render environment settings.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_LONG_PASSWORD

PORT=3000
NODE_ENV=development
